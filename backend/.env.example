PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_KEY=change-this-demo-key

# MongoDB Atlas Connection String Format:
# Replace <username>, <password>, and <cluster-url> with your Atlas details.
# E.g.: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/eventora?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/eventora?retryWrites=true&w=majority
